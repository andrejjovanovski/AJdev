# Backend that serves portfolio content (projects, experience, profile).
# Points at the AJdevBackendApi (.NET) project. Leave empty to use the bundled
# dummy data and the local /api routes.
NEXT_PUBLIC_API_URL=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=andrej@example.com

# /portal — the content admin.
# Sign-in authenticates against the backend admin user
# (AppSettings:AdminUsername / AppSettings:AdminPassword in AJdevBackendApi).
# This secret only signs the session cookie. Generate: openssl rand -base64 32
PORTAL_SESSION_SECRET=
