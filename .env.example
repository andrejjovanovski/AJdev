# Backend that serves portfolio content (projects, skills, experience, ratings).
# Leave empty to use the bundled dummy data and the local /api routes.
NEXT_PUBLIC_API_URL=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=andrej@example.com

# /portal — the content admin. All three are required for sign-in to work.
PORTAL_EMAIL=you@example.com
# node scripts/portal-password.mjs "your password"  → prints this line
PORTAL_PASSWORD_HASH=
# Signs the session cookie. Generate: openssl rand -base64 32
PORTAL_SESSION_SECRET=
